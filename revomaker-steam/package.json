{
  "name": "revomaker-steam",
  "version": "1.0.0",
  "private": true,
  "description": "REVOMAKER STEAM — premium gaming drop platform with a private owner console.",
  "main": "server/index.js",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning server/index.js",
